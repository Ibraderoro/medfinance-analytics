# ──────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ──────────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medfinance
POSTGRES_USER=medfinance_user
POSTGRES_PASSWORD=change_me_in_production

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=30
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# ──────────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production
REDIS_TLS=false
REQUIRE_SECURE_TRANSPORT=false

HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=35000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

# ──────────────────────────────────────────────────
# JWT / Auth
# ──────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_strong_secret_256_bits
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=change_me_to_another_strong_secret
REFRESH_TOKEN_EXPIRES_IN=7d
AUDIT_EXPORT_SIGNING_SECRET=change_me_to_a_strong_audit_signing_secret_256_bits
ALLOW_SELF_SERVICE_REGISTRATION=true

ANALYTICS_SAMPLE_RATE=1
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL_MS=1000
ANALYTICS_MAX_QUEUE_SIZE=10000

# ──────────────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api/v1

# Docker / Deployment
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443


# ──────────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Optional OIDC SSO callback integration
OIDC_ISSUER=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
