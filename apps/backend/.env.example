NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

DATABASE_URL=postgresql://medfinance_user:devpassword@localhost:5432/medfinance_dev
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=false
PG_POOL_MAX=30
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# Managed Redis: set REDIS_URL and leave host/port as defaults.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REQUIRE_SECURE_TRANSPORT=false

HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=35000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

JWT_SECRET=change_me_to_a_minimum_32_character_secret
JWT_ISSUER=medfinance-api
JWT_AUDIENCE=medfinance-client
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=change_me_to_a_minimum_32_character_refresh_secret
REFRESH_TOKEN_EXPIRES_IN=7d
AUDIT_EXPORT_SIGNING_SECRET=change_me_to_a_minimum_32_character_audit_signing_secret

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOW_SELF_SERVICE_REGISTRATION=true

ANALYTICS_SAMPLE_RATE=1
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL_MS=1000
ANALYTICS_MAX_QUEUE_SIZE=10000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Optional OIDC SSO callback integration
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
