NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

DATABASE_URL=postgresql://medfinance_user:devpassword@localhost:5432/medfinance_dev
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=false

# Managed Redis: set REDIS_URL and leave host/port as defaults.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

JWT_SECRET=change_me_to_a_minimum_32_character_secret
JWT_ISSUER=medfinance-api
JWT_AUDIENCE=medfinance-client
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=change_me_to_a_minimum_32_character_refresh_secret
REFRESH_TOKEN_EXPIRES_IN=7d

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
