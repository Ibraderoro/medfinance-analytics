{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": [
    "<rootDir>/src"
  ],
  "testMatch": [
    "**/__tests__/**/*.test.ts"
  ],
  "coverageDirectory": "coverage",
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.d.ts",
    "!src/__tests__/**",
    "!src/test/**"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 40,
      "functions": 45,
      "lines": 51,
      "statements": 50
    },
    "./src/services/auth.service.ts": {
      "branches": 49,
      "functions": 73,
      "lines": 73,
      "statements": 71
    },
    "./src/services/billing.service.ts": {
      "branches": 75,
      "functions": 90,
      "lines": 87,
      "statements": 86
    },
    "./src/middleware/tenantContext.ts": {
      "branches": 50,
      "functions": 85,
      "lines": 72,
      "statements": 71
    },
    "./src/services/financials.service.ts": {
      "branches": 22,
      "functions": 25,
      "lines": 48,
      "statements": 45
    },
    "./src/services/forecasting/forecastingMath.ts": {
      "branches": 70,
      "functions": 90,
      "lines": 90,
      "statements": 90
    }
  },
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.test.json"
      }
    ]
  },
  "setupFiles": [
    "<rootDir>/src/__tests__/setup-env.ts"
  ],
  "testPathIgnorePatterns": [
    "<rootDir>/src/__tests__/integration/"
  ]
}
