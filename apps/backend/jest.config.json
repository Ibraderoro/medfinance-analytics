{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": [
    "<rootDir>/src"
  ],
  "testMatch": [
    "**/__tests__/**/*.test.ts"
  ],
  "coverageDirectory": "coverage",
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.d.ts",
    "!src/__tests__/**",
    "!src/test/**",
    "!src/index.ts",
    "!src/db/**",
    "!src/config/**",
    "!src/observability/**",
    "!src/controllers/**",
    "!src/services/liveFinancials.service.ts"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 60,
      "functions": 70,
      "lines": 70,
      "statements": 70
    }
  },
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.test.json"
      }
    ]
  },
  "setupFiles": [
    "<rootDir>/src/__tests__/setup-env.ts"
  ],
  "testPathIgnorePatterns": [
    "<rootDir>/src/__tests__/integration/"
  ]
}
