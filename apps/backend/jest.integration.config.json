{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": [
    "<rootDir>/src"
  ],
  "testMatch": [
    "**/__tests__/integration/**/*.integration-real.test.ts"
  ],
  "testTimeout": 30000,
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.test.json"
      }
    ]
  },
  "setupFiles": [
    "<rootDir>/src/__tests__/setup-env.ts"
  ]
}
