{
  "name": "@medfinance/backend",
  "version": "1.0.0",
  "private": true,
  "description": "MedFinance Analytics — Express REST API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "worker:dev": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc --project tsconfig.json && mkdir -p dist/db/migrations && cp -R src/db/migrations/. dist/db/migrations/",
    "serve": "node dist/index.js",
    "serve:worker": "node dist/worker.js",
    "start": "npm run build && npm run serve",
    "lint": "eslint 'src/**/*.ts'",
    "test": "jest --coverage",
    "migrate": "node -r ts-node/register src/db/migrate.ts",
    "migrate:rollback": "node -r ts-node/register src/db/migrate.ts rollback",
    "clean": "rm -rf dist",
    "seed": "node -r ts-node/register src/db/seed.ts",
    "test:integration": "jest --config jest.integration.config.json --runInBand",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "migrate:preflight": "node -r ts-node/register src/db/migrate.ts preflight",
    "migrate:status": "node -r ts-node/register src/db/migrate.ts status",
    "db:tenant-isolation:verify": "node -r ts-node/register src/db/migrate.ts verify-tenant-isolation"
  },
  "dependencies": {
    "@medfinance/shared": "*",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
