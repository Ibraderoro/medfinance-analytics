{
  "preset": "ts-jest",
  "testEnvironment": "jsdom",
  "roots": [
    "<rootDir>/src"
  ],
  "testMatch": [
    "**/__tests__/**/*.test.ts?(x)"
  ],
  "setupFilesAfterEnv": [
    "<rootDir>/src/test/setup.ts"
  ],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "\\.(css|less|scss|sass)$": "<rootDir>/src/test/styleMock.ts",
    "^d3$": "<rootDir>/../../node_modules/d3/dist/d3.js"
  },
  "collectCoverageFrom": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.d.ts",
    "!src/__tests__/**",
    "!src/test/**",
    "!src/main.tsx"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 85,
      "functions": 88,
      "lines": 90,
      "statements": 90
    }
  },
  "transform": {
    "^.+\\.tsx?$": "ts-jest"
  }
}
