{
  "preset": "ts-jest",
  "testEnvironment": "jsdom",
  "roots": [
    "<rootDir>/src"
  ],
  "testMatch": [
    "**/__tests__/**/*.test.ts?(x)"
  ],
  "setupFilesAfterEnv": [
    "<rootDir>/src/test/setup.ts"
  ],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "\\.(css|less|scss|sass)$": "<rootDir>/src/test/styleMock.ts"
  },
  "collectCoverageFrom": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.d.ts"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 50,
      "functions": 35,
      "lines": 39,
      "statements": 38
    }
  },
  "transform": {
    "^.+\\.tsx?$": "ts-jest"
  }
}
