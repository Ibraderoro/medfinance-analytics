    },
    {
      "type": "timeseries",
      "title": "DB p95 Query Latency (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "db_query_duration_p95_ms", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Redis p95 Operation Latency (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
