{
  "name": "medfinance-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade monorepo for healthcare financial analytics",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=apps/backend",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "migrate": "npm run migrate --workspace=apps/backend",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "seed": "npm run seed --workspace=apps/backend",
    "test:e2e": "npm run test:e2e --workspace=apps/frontend",
    "audit:prod": "node scripts/run-prod-audit.js",
    "test:integration": "npm run test:integration --workspace=apps/backend",
    "coverage:prod": "npm test --workspaces --if-present -- --coverageReporters=json-summary --coverageReporters=text-summary && node scripts/check-production-coverage-targets.js",
    "staging:drills:check": "node scripts/check-staging-drill-gate.js",
    "production:external-evidence:check": "node scripts/check-external-provider-evidence.js",
    "production:security-evidence:check": "node scripts/check-vulnerability-evidence.js && npm run security:check-lockfile-ws && npm run security:check-lockfile-qs && npm run security:check-lockfile-react-router",
    "production:e2e-evidence:check": "node scripts/check-playwright-e2e-evidence.js",
    "security:check-lockfile-ws": "node scripts/check-lockfile-ws-version.js",
    "staging:drills:run": "node scripts/run-staging-drills.js",
    "production:gates:check": "npm run coverage:prod && npm run test:integration && npm run production:external-evidence:check && npm run production:security-evidence:check && npm run production:e2e-evidence:check && npm run staging:drills:check",
    "security:check-lockfile-qs": "node scripts/check-lockfile-qs-version.js",
    "security:check-lockfile-react-router": "node scripts/check-lockfile-react-router-version.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "perf:api:bench": "node scripts/performance/run-api-bench.js",
    "perf:load:smoke": "node scripts/performance/k6-runner.js smoke load-mixed",
    "perf:load:peak": "node scripts/performance/k6-runner.js peak load-mixed",
    "perf:stress:step": "node scripts/performance/k6-runner.js stress-step stress-step",
    "perf:stress:spike": "node scripts/performance/k6-runner.js stress-spike stress-spike",
    "perf:soak": "node scripts/performance/k6-runner.js soak soak-peak",
    "perf:db:analyze": "node scripts/performance/run-db-analysis.js",
    "perf:redis:check": "node scripts/performance/run-redis-check.js",
    "perf:report": "node scripts/performance/run-report.js",
    "migrate:preflight": "npm run migrate:preflight --workspace=apps/backend",
    "migrate:status": "npm run migrate:status --workspace=apps/backend",
    "migrate:rollback": "npm run migrate:rollback --workspace=apps/backend",
    "release:manifest": "node scripts/deployment/build-release-manifest.js",
    "release:manifest:check": "node scripts/deployment/validate-release-manifest.js",
    "deploy:verify": "node scripts/deployment/verify-deployment.js",
    "test:e2e:mock": "npm run test:e2e:mock --workspace=apps/frontend",
    "test:e2e:full": "npm run test:e2e:full --workspace=apps/frontend",
    "e2e:full-stack": "bash scripts/e2e/run-full-stack-e2e.sh"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "autocannon": "^7.15.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "ws": "^8.20.2",
    "form-data": "4.0.6",
    "qs": "^6.15.2",
    "uuid": "11.1.1",
    "braces": "^3.0.3",
    "lodash": "^4.17.21",
    "set-value": "^4.1.0",
    "js-yaml": "^4.1.0",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2"
  }
}
