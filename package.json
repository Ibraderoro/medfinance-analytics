{
  "name": "medfinance-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade monorepo for healthcare financial analytics",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=apps/backend",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "migrate": "npm run migrate --workspace=apps/backend",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "seed": "npm run seed --workspace=apps/backend",
    "test:e2e": "npm run test:e2e --workspace=apps/frontend",
    "audit:prod": "node scripts/run-prod-audit.js",
    "test:integration": "npm run test:integration --workspace=apps/backend",
    "coverage:prod": "npm test --workspaces --if-present -- --coverageReporters=json-summary --coverageReporters=text-summary && node scripts/check-production-coverage-targets.js",
    "staging:drills:check": "node scripts/check-staging-drill-gate.js",
    "production:external-evidence:check": "node scripts/check-external-provider-evidence.js",
    "production:security-evidence:check": "node scripts/check-vulnerability-evidence.js",
    "production:e2e-evidence:check": "node scripts/check-playwright-e2e-evidence.js"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "ws": "8.20.1"
  }
}
